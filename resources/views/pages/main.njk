{# resources/views/pages/main.njk #}

{% set title = "PDFStorm — онлайн-сервис для работы с PDF" %}

{% block content %}
<section class="hero relative overflow-hidden pt-5 md:pt-8 2xl:pt-12 3xl:pt-23.75">
  <div class="container">

    <h1
      class="relative z-10 text-white font-extrabold 
      text-3xl min-[864px]:text-[40px] min-[1024px]:text-[50px] min-[1680px]:text-6xl 
      max-w-[290px] min-[864px]:max-w-[374px] min-[1024px]:max-w-[474px] min-[1680px]:max-w-[735px] min-[1920px]:max-w-[830px] 
      min-h-[150px] min-[864px]:min-h-[230px] min-[1024px]:min-h-[318px] min-[1920px]:min-h-[318px] 
      leading-tight 
      before:absolute before:w-[1000%] before:bg-Framework-primary before:h-full before:-z-1 before:-left-[200%]
      flex items-center">
      Все инструменты для конвертации PDF онлайн
    </h1>

    <div class="relative z-100 flex flex-wrap gap-2 pt-3.75 pb-3.75">
      <button class="hero-filter active px-3">Все</button>
      <button class="hero-filter">Конвертировать</button>
      <button class="hero-filter">Редактировать</button>
      <button class="hero-filter">Безопасность</button>
      <button class="hero-filter">Картинки</button>
      <button class="hero-filter">Другое</button>
    </div>

  </div>

  <!-- Изображение справа -->
  <div
    class="absolute 
    -right-19 lg: xl:right-9.25 min-[1920px]:right-16.5 
    -top-15.5 lg:top-1/2 lg:-translate-y-1/2 min-w-[1680px]:translate-0 min-[1680px]:-top-31.75 min-[1920px]:-top-27.5 
    z-11
    before:absolute before:bg-[url('resources/images/storm1-bg.svg')] before:bg-no-repeat before:blur-[204px] before:top-0 before:left-0 before:w-full before:h-[582px] before:-z-5  
    hidden min-[864px]:block">
    <img src="resources/images/storm1-pic.png" alt="PDF tools" class="z-20 
    w-full max-w-[556px] min-[1024px]:max-w-[682px] min-[1680px]:max-w-[782px] min-[1920px]:max-w-[878px] 
    pointer-events-none select-none 
    " />
  </div>
</section>

